# Copy to `.env` and fill in only what you need. `.env` is gitignored.
#
#   cp .env.example .env
#
# On Colab/Kaggle prefer the built-in secret managers instead of uploading a
# .env file (Colab: the key icon in the sidebar; Kaggle: Add-ons > Secrets).
# Both are read automatically when named exactly as below.

# --- Notebook side -----------------------------------------------------------

# Key clients must send as `Authorization: Bearer <key>`.
# Leave it empty and a random one is generated and printed on every run.
GPUFREE_API_KEY=

# Hugging Face token. Only needed for gated models (Llama, Gemma, Mistral
# official repos...). https://huggingface.co/settings/tokens
HF_TOKEN=

# ngrok authtoken, only if you run with `--tunnel ngrok`.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: reserved domain from the ngrok dashboard, for a URL that never changes.
NGROK_DOMAIN=

# --- Both sides --------------------------------------------------------------

# GitHub token with the `gist` scope. Used to publish/discover the endpoint, so
# `gpufree connect --gist` works without copy-pasting URLs.
# https://github.com/settings/tokens  (fine-grained: Gists = read and write)
# Locally you can skip this: the CLI falls back to `gh auth token`.
GITHUB_TOKEN=

# --- Local side (optional) ---------------------------------------------------

# Skip `gpufree connect` entirely by pointing at an endpoint directly.
# GPUFREE_URL=https://something.trycloudflare.com/v1
